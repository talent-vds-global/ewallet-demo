# Sao chép thành .env rồi điền. KHÔNG commit .env.

# --- Atlassian ---
# Du an ca nhan: site Atlassian Cloud mien phi cua ban, email ca nhan cua ban
ATLASSIAN_BASE_URL=https://your-site.atlassian.net
ATLASSIAN_EMAIL=you@gmail.com
ATLASSIAN_API_TOKEN=

# --- Confluence ---
# Space thuong: EWL. Space ca nhan: dan key dang ~xxxxxxxx (xem trong URL /wiki/spaces/~xxxx)
CONFLUENCE_SPACE_KEY=EWL
CONFLUENCE_ROOT_PAGE_TITLE=E-Wallet Business Specs
# macro = dùng app Mermaid Diagrams for Confluence; codeblock = dùng macro Code Block
MERMAID_MODE=codeblock
# tên macro nếu MERMAID_MODE=macro
MERMAID_MACRO_NAME=mermaid-cloud

# --- Jira ---
JIRA_PROJECT_KEY=EWL
JIRA_LABEL_PREFIX=

# --- Custom field id (lấy bằng: GET /rest/api/3/field) ---
JIRA_CF_FLOW_SLUG=customfield_10050
JIRA_CF_RULE_CODES=customfield_10051
JIRA_CF_NFR_CODES=customfield_10052
JIRA_CF_CONFLUENCE_PAGE=customfield_10053
JIRA_CF_SERVICE=customfield_10054
JIRA_CF_DEFECT_ID=customfield_10055
JIRA_CF_VERDICT=customfield_10056

# --- Đường dẫn cục bộ ---
KIT_DIR=../..
SPECS_DIR=../../../ewallet-demo/docs/specs
EXPORT_DIR=./export
